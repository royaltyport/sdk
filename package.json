{
  "name": "@royaltyport/sdk",
  "version": "2.0.0",
  "type": "module",
  "description": "Official Node.js SDK for the Royaltyport API",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest",
    "test:integration": "vitest run --project integration",
    "lint": "eslint",
    "link:sdk": "sh scripts/link.sh",
    "unlink:sdk": "sh scripts/unlink.sh",
    "publish:sdk": "npm publish --access public",
    "publish:beta": "npm publish --access public --tag beta",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^6.0.0",
    "vitest": "4.1.12"
  },
  "keywords": [
    "royaltyport",
    "sdk",
    "music",
    "royalties",
    "api"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/royaltyport/sdk.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "vite": {
      ".": "7.3.7",
      "esbuild": "0.28.2",
      "postcss": "8.5.30"
    },
    "tsup": {
      "esbuild": "0.28.2",
      "postcss": "8.5.30"
    }
  }
}
